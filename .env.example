# Optional Gemini API key for AI-generated content.
GEMINI_API_KEY=

# Public app URL used for links and QR codes.
APP_URL=

# Optional server configuration (defaults shown).
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
DISABLE_HMR=false
GEMINI_MODEL=gemini-2.5-flash
CONTENT_AI_DISABLED=false

# Guess the Link image pipeline (all optional).
IMAGE_PROVIDER=none          # gemini | mock | none
IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_API_KEY=
IMAGE_CONCURRENCY=3
LINK_IMAGE_DAILY_BUDGET=300
LINK_IMAGE_TIMEOUT_MS=25000
LINK_IMAGE_CHECK=false
WARM_POOL_SIZE=6
LOOKAHEAD_DEPTH=2
LIBRARY_DIR=data/puzzle-library
LIBRARY_MAX=500
